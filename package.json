{
  "name": "venue-desk-svelte",
  "version": "1.0.0",
  "description": "The guest side of Venue Desk in Svelte 5 and SvelteKit: event list, seat booking and feedback.",
  "license": "MIT",
  "author": "Emanuel Pinto (https://riverdevstudio.it)",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "e2e": "start-server-and-test start http://localhost:5173 e2e:run",
    "e2e:run": "cypress run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/cypress": "10.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "cypress": "15.5.0",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "start-server-and-test": "3.0.13",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
